# ---------------------------------------------------------------------------
# Journey Simulator — environment configuration
# Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Core services ---
DATABASE_URL=postgresql://journey:journey@127.0.0.1:5432/journey
REDIS_URL=redis://127.0.0.1:6379
# Prefix for BullMQ keys (lets several environments share one Redis).
QUEUE_PREFIX=js

# 32 random bytes, base64. Encrypts proxy credentials and browser storage states.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- API ---
API_HOST=127.0.0.1
API_PORT=4000
# Public origin of the web UI. Mutating requests from other origins are rejected.
APP_ORIGIN=http://localhost:3000
# Set to true behind HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
ALLOW_REGISTRATION=true
RATE_LIMIT_PER_MINUTE=300
# Set to true when running behind a reverse proxy / load balancer.
TRUST_PROXY=false
LOG_LEVEL=info

# --- Web ---
# Where the Next.js server forwards /api/* (server-side only).
API_INTERNAL_URL=http://127.0.0.1:4000

# --- Network policy (administrator only) ---
# Hosts that may resolve to private/loopback addresses. Everything else must be public.
# Keep this to the bundled demo site / your own QA hosts. Cloud metadata IPs are always blocked.
PRIVATE_HOST_ALLOWLIST=localhost:4100,127.0.0.1:4100,127.0.0.1:8899
# Allow sub-resources (CDN scripts, fonts) from public third-party hosts. Navigation off
# authorized domains is always blocked.
ALLOW_THIRD_PARTY_SUBRESOURCES=true
# Page used to detect proxy egress IPs. Must return {"ip": "..."} or a plain IP.
PROXY_CHECK_URL=https://api.ipify.org?format=json
PROXY_TEST_TIMEOUT_MS=45000

# --- Platform limits (administrator only; users cannot exceed these) ---
LIMIT_MAX_ITERATIONS_PER_BATCH=100
LIMIT_MAX_CONCURRENCY_PER_BATCH=3
LIMIT_MAX_ACTIVE_BATCHES_PER_PROJECT=3
LIMIT_MAX_ACTIVE_RUNS_PER_DOMAIN=5
LIMIT_MAX_ACTIVE_RUNS_SYSTEM=10
LIMIT_MIN_LAUNCH_DELAY_MS=0

# --- Worker ---
# Parallel browsers per worker process (scale out by adding worker containers).
WORKER_CONCURRENCY=2
WORKER_HEARTBEAT_MS=5000
WORKER_STALE_AFTER_MS=60000
WORKER_MAX_INFRA_ATTEMPTS=2
WORKER_HEADLESS=true
# WORKER_ID=worker-1

# --- Artifact storage ---
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.artifacts
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=           # e.g. http://minio:9000 for MinIO
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Demo site ---
DEMO_SITE_PORT=4100
